# Copy to .env (gitignored), then use --dart-define-from-file=.env.
# Every value is optional. Stasis AI remains fully local without them.
STASIS_LLM_BASE_URL=http://192.168.1.50:8000/v1
STASIS_LLM_MODEL=llama3.1:8b
STASIS_BACKEND_URL=https://stasis.example.com
# Set true only after replacing firebase_options.dart and native files with
# configuration from a Firebase project you control.
STASIS_FIREBASE_ENABLED=false
STASIS_PRIVACY_URL=https://your-domain.example/privacy

# Legacy OpenStrap cloud/companion variables are intentionally absent. The
# corresponding compatibility clients therefore remain disabled.
